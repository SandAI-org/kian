{
  "name": "kian-code-review",
  "displayName": "Kian Review",
  "description": "%description%",
  "version": "0.6.3",
  "publisher": "strivin0311",
  "license": "AGPL-3.0-only",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "SCM Providers"
  ],
  "main": "./src/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "extensionDependencies": [
    "vscode.git"
  ],
  "activationEvents": [
    "onView:kianReview.files"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": false
  },
  "l10n": "./l10n",
  "scripts": {
    "test": "node --test test/*.test.js",
    "package:vsix": "node scripts/package.js"
  },
  "contributes": {
    "commands": [
      {
        "command": "kianReview.branches",
        "title": "%branches%",
        "category": "Kian Review",
        "icon": "$(git-compare)"
      },
      {
        "command": "kianReview.commit",
        "title": "%commit%",
        "category": "Kian Review",
        "icon": "$(git-commit)"
      },
      {
        "command": "kianReview.refresh",
        "title": "%refresh%",
        "category": "Kian Review",
        "icon": "$(refresh)"
      },
      {
        "command": "kianReview.repository",
        "title": "%repository%",
        "category": "Kian Review",
        "icon": "$(repo)"
      },
      {
        "command": "kianReview.filter",
        "title": "%filter%",
        "category": "Kian Review",
        "icon": "$(filter)"
      },
      {
        "command": "kianReview.swap",
        "title": "%swap%",
        "category": "Kian Review",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "kianReview.open",
        "title": "%open%",
        "category": "Kian Review",
        "icon": "$(diff)"
      },
      {
        "command": "kianReview.copyRelative",
        "title": "%copyRelative%",
        "category": "Kian Review",
        "icon": "$(copy)"
      },
      {
        "command": "kianReview.copyAbsolute",
        "title": "%copyAbsolute%",
        "category": "Kian Review",
        "icon": "$(copy)"
      },
      {
        "command": "kianReview.openWorkingFile",
        "title": "%openWorkingFile%",
        "category": "Kian Review",
        "icon": "$(go-to-file)"
      },
      {
        "command": "kianReview.show",
        "title": "%show%",
        "category": "Kian Review",
        "icon": "$(git-compare)"
      },
      {
        "command": "kianReview.mode",
        "title": "%mode%",
        "category": "Kian Review",
        "icon": "$(git-compare)"
      },
      {
        "command": "kianReview.base",
        "title": "%base%",
        "category": "Kian Review",
        "icon": "$(git-commit)"
      },
      {
        "command": "kianReview.target",
        "title": "%target%",
        "category": "Kian Review",
        "icon": "$(git-branch)"
      },
      {
        "command": "kianReview.expand",
        "title": "%expand%",
        "category": "Kian Review",
        "icon": "$(expand-all)"
      },
      {
        "command": "kianReview.collapse",
        "title": "%collapse%",
        "category": "Kian Review",
        "icon": "$(collapse-all)"
      },
      {
        "command": "kianReview.previousCommit",
        "title": "%previousCommit%",
        "category": "Kian Review",
        "icon": "$(arrow-left)",
        "enablement": "kianReview.hasPreviousCommit"
      },
      {
        "command": "kianReview.nextCommit",
        "title": "%nextCommit%",
        "category": "Kian Review",
        "icon": "$(arrow-right)",
        "enablement": "kianReview.hasNextCommit"
      },
      {
        "command": "kianReview.addPrivateNote",
        "title": "%addPrivateNote%",
        "category": "Kian Review",
        "icon": "$(comment)"
      },
      {
        "command": "kianReview.savePrivateNote",
        "title": "%savePrivateNote%",
        "category": "Kian Review",
        "enablement": "!commentIsEmpty"
      },
      {
        "command": "kianReview.resolvePrivateNote",
        "title": "%resolvePrivateNote%",
        "category": "Kian Review",
        "icon": "$(check)"
      },
      {
        "command": "kianReview.reopenPrivateNote",
        "title": "%reopenPrivateNote%",
        "category": "Kian Review",
        "icon": "$(discard)"
      },
      {
        "command": "kianReview.copyPrompts",
        "title": "%copyPrompts%",
        "category": "Kian Review",
        "icon": "$(copy)"
      },
      {
        "command": "kianReview.connectPR",
        "title": "%connectPR%",
        "category": "Kian Review",
        "icon": "$(github)"
      },
      {
        "command": "kianReview.saveEditedPrivateNote",
        "title": "%savePrivateNote%",
        "category": "Kian Review"
      },
      {
        "command": "kianReview.cancelEditPrivateNote",
        "title": "%cancelEditPrivateNote%",
        "category": "Kian Review"
      }
    ],
    "views": {
      "scm": [
        {
          "id": "kianReview.files",
          "name": "Kian Review",
          "icon": "media/review.svg",
          "contextualTitle": "Kian Review",
          "type": "webview"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "kianReview.files",
        "contents": "%welcome%"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "kianReview.branches",
          "when": "view == kianReview.files",
          "group": "navigation@0"
        },
        {
          "command": "kianReview.commit",
          "when": "view == kianReview.files",
          "group": "navigation@1"
        },
        {
          "command": "kianReview.refresh",
          "when": "view == kianReview.files",
          "group": "navigation@2"
        },
        {
          "command": "kianReview.filter",
          "when": "view == kianReview.files",
          "group": "navigation@3"
        },
        {
          "command": "kianReview.repository",
          "when": "view == kianReview.files",
          "group": "comparison"
        },
        {
          "command": "kianReview.swap",
          "when": "view == kianReview.files",
          "group": "comparison"
        },
        {
          "command": "kianReview.expand",
          "when": "view == kianReview.files",
          "group": "navigation@4"
        },
        {
          "command": "kianReview.collapse",
          "when": "view == kianReview.files",
          "group": "navigation@5"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "kianReview.savePrivateNote",
          "group": "inline",
          "when": "commentController == kianReview.notes && commentThreadIsEmpty"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "kianReview.resolvePrivateNote",
          "group": "navigation@1",
          "when": "commentController == kianReview.notes && commentThread == kianNoteOpen"
        },
        {
          "command": "kianReview.reopenPrivateNote",
          "group": "navigation@1",
          "when": "commentController == kianReview.notes && commentThread == kianNoteResolved"
        }
      ],
      "editor/context": [
        {
          "command": "kianReview.addPrivateNote",
          "group": "kianReview",
          "when": "kianReview.noteDocument && editorTextFocus"
        }
      ],
      "commandPalette": [
        {
          "command": "kianReview.savePrivateNote",
          "when": "false"
        },
        {
          "command": "kianReview.resolvePrivateNote",
          "when": "false"
        },
        {
          "command": "kianReview.reopenPrivateNote",
          "when": "false"
        },
        {
          "command": "kianReview.saveEditedPrivateNote",
          "when": "false"
        },
        {
          "command": "kianReview.cancelEditPrivateNote",
          "when": "false"
        }
      ],
      "comments/comment/context": [
        {
          "command": "kianReview.saveEditedPrivateNote",
          "group": "inline@1",
          "when": "commentController == kianReview.notes && comment == kianPrivateNote"
        },
        {
          "command": "kianReview.cancelEditPrivateNote",
          "group": "inline@2",
          "when": "commentController == kianReview.notes && comment == kianPrivateNote"
        }
      ]
    },
    "keybindings": [
      {
        "key": "enter",
        "command": "editor.action.submitComment",
        "when": "commentEditorFocused && commentController == kianReview.notes && !inComposition"
      },
      {
        "key": "shift+enter",
        "command": "type",
        "args": {
          "text": "\n"
        },
        "when": "commentEditorFocused && commentController == kianReview.notes && !inComposition"
      }
    ]
  }
}
