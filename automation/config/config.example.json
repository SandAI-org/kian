{
  "services": {
    "bridge": { "enabled": true },
    "realtime": { "enabled": true, "interval_seconds": 300 },
    "daily": { "enabled": true, "hour": 10, "minute": 0 },
    "qr": { "enabled": false, "hour": 12, "minute": 0 }
  },
  "feishu": {
    "app_id": "REPLACE_WITH_FEISHU_APP_ID",
    "app_secret": "REPLACE_WITH_FEISHU_APP_SECRET",
    "open_id": "REPLACE_WITH_FEISHU_OPEN_ID",
    "allowed_users": ["REPLACE_WITH_ALLOWED_OPEN_ID"]
  },
  "github": {
    "tokens": {
      "example-owner": "REPLACE_WITH_GITHUB_TOKEN"
    },
    "repos": ["example-owner/example-repo"]
  },
  "pr_manager": {
    "special_layout_repo": "example-owner/example-repo",
    "legacy_replacements": {}
  },
  "summarization": {
    "api_key": "REPLACE_WITH_SUMMARIZATION_API_KEY",
    "model": "REPLACE_WITH_MODEL_NAME"
  },
  "file_transfer": {
    "downloads": "REPLACE_WITH_DOWNLOADS_DIRECTORY",
    "machines": {
      "example-machine": {
        "ssh_host": "REPLACE_WITH_SSH_CONFIG_ALIAS",
        "path_mappings": [
          {
            "from": "REPLACE_WITH_SOURCE_PREFIX",
            "to": "REPLACE_WITH_DESTINATION_PREFIX"
          }
        ]
      }
    }
  },
  "wheel_sync": {
    "profiles": {
      "example-image": {
        "selection_mode": "stable",
        "source_machine": "example-source-machine",
        "dist_dirs": [
          "REPLACE_WITH_FIRST_DIST_DIRECTORY",
          "REPLACE_WITH_SECOND_DIST_DIRECTORY"
        ],
        "destination_machines": [
          "example-source-machine",
          "example-destination-machine"
        ],
        "target_dir": "REPLACE_WITH_IMAGE_SPECIFIC_WHEEL_DIRECTORY",
        "stable_versions": {
          "example_distribution_one": "REPLACE_WITH_STABLE_VERSION",
          "example_distribution_two": "REPLACE_WITH_STABLE_VERSION"
        }
      },
      "example-dev-image": {
        "selection_mode": "latest",
        "source_machine": "example-source-machine",
        "dist_dirs": [
          "REPLACE_WITH_FIRST_DIST_DIRECTORY",
          "REPLACE_WITH_SECOND_DIST_DIRECTORY"
        ],
        "destination_machines": [
          "example-source-machine",
          "example-destination-machine"
        ],
        "target_dir": "REPLACE_WITH_DEV_IMAGE_SPECIFIC_WHEEL_DIRECTORY",
        "expected_distributions": [
          "example_distribution_one",
          "example_distribution_two"
        ]
      }
    }
  },
  "qr_publish": {
    "repo_dir": "REPLACE_WITH_ABSOLUTE_REPO_DIRECTORY",
    "target_file": "REPLACE_WITH_REPOSITORY_RELATIVE_IMAGE_FILE",
    "branch": "REPLACE_WITH_BRANCH",
    "commit_message": "chore: update QR code ({date})",
    "reminder_title": "REPLACE_WITH_REMINDER_TITLE",
    "reminder_body": "REPLACE_WITH_REMINDER_BODY"
  }
}
