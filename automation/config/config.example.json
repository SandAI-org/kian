{
  "services": {
    "bridge": { "enabled": true },
    "realtime": { "enabled": true, "interval_seconds": 300 },
    "daily": { "enabled": true, "hour": 10, "minute": 0 },
    "qr": { "enabled": false, "hour": 12, "minute": 0 },
    "reminders": { "enabled": false, "poll_interval_seconds": 60 },
    "codex_lock_guard": { "enabled": false },
    "codex_activity_monitor": { "enabled": false, "interval_seconds": 60 },
    "public_watch": {
      "enabled": false,
      "interval_seconds": 3600,
      "retry_interval_seconds": 300,
      "flush_hour": 10,
      "flush_minute": 30
    }
  },
  "codex_activity_monitor": {
    "targets": [{
      "id": "example-codex",
      "label": "Example workspace",
      "host": "REPLACE_WITH_SSH_ALIAS",
      "container": "REPLACE_WITH_CONTAINER_NAME",
      "codex_home": "/root/.codex",
      "workspaces": ["REPLACE_WITH_EXACT_REMOTE_WORKSPACE"]
    }]
  },
  "codex_lock_guard": {
    "quiet_seconds": 120,
    "confirmation_seconds": 60,
    "targets": [
      {
        "id": "example-workspaces",
        "host": "REPLACE_WITH_SSH_ALIAS",
        "container": "REPLACE_WITH_CONTAINER_NAME",
        "codex_home": "REPLACE_WITH_REMOTE_CODEX_HOME",
        "server_root": "REPLACE_WITH_REMOTE_VSCODE_SERVER_ROOT",
        "workspaces": ["REPLACE_WITH_EXACT_REMOTE_WORKSPACE"]
      }
    ]
  },
  "feishu": {
    "app_id": "REPLACE_WITH_FEISHU_APP_ID",
    "app_secret": "REPLACE_WITH_FEISHU_APP_SECRET",
    "open_id": "REPLACE_WITH_FEISHU_OPEN_ID",
    "allowed_users": ["REPLACE_WITH_ALLOWED_OPEN_ID"]
  },
  "reminders": {
    "supplement": {
      "enabled": true,
      "schedule": { "hour": 13, "minute": 0 },
      "title": "💊 补品提醒",
      "body": "别忘了今天的补品哦：\n\n🔸 复合维生素\n🔸 鱼油\n🔸 维生素C咀嚼片",
      "confirmation_required": true,
      "confirm_button_text": "已服用",
      "confirmed_button_text": "今日已服用 ✓",
      "confirmed_toast": "已记录今日服用，不再重复提醒",
      "repeat_interval_seconds": 300
    }
  },
  "github": {
    "tokens": {
      "example-owner": "REPLACE_WITH_GITHUB_TOKEN"
    },
    "repos": ["example-owner/example-repo"]
  },
  "public_watch": {
    "token_from_owner": "example-owner",
    "sources": [
      {
        "id": "anthropic-research",
        "name": "Anthropic Research",
        "index_url": "https://www.anthropic.com/research",
        "link_pattern": "^/research/[^/]+$"
      }
    ],
    "quiet_hours": {
      "enabled": true,
      "timezone": "Asia/Shanghai",
      "start": "00:00",
      "end": "10:30"
    },
    "repositories": [
      {
        "repo": "pytorch/pytorch",
        "level": "balanced",
        "blogs": [
          {
            "name": "PyTorch Blog",
            "feed_url": "https://pytorch.org/blog/feed/"
          }
        ],
        "web_releases": [
          {
            "name": "NVIDIA PyTorch NGC",
            "index_url": "https://docs.nvidia.com/deeplearning/frameworks/pytorch-release-notes/index.html",
            "link_pattern": "rel-(?P<version>[0-9]{2}-[0-9]{2})\\.html"
          }
        ],
        "exclude": {
          "title_patterns": ["\\b(?:amd|rocm|hip|xpu)\\b"],
          "label_patterns": ["amd|rocm|hip|xpu"],
          "path_patterns": ["(^|/)(?:amd|rocm|hip|xpu)(?:/|$)"],
          "path_match": "all"
        }
      },
      {
        "repo": "NVIDIA/Megatron-LM",
        "level": "detailed",
        "integration_branches": ["dev"]
      }
    ]
  },
  "pr_manager": {
    "special_layout_repo": "example-owner/example-repo",
    "legacy_replacements": {},
    "sync_source_overrides": {}
  },
  "summarization": {
    "backend": "copilot_cli",
    "command": "REPLACE_WITH_COPILOT_CLI_PATH",
    "model": "auto"
  },
  "file_transfer": {
    "downloads": "REPLACE_WITH_DOWNLOADS_DIRECTORY",
    "machines": {
      "example-machine": {
        "ssh_host": "REPLACE_WITH_SSH_CONFIG_ALIAS",
        "path_mappings": [
          {
            "from": "REPLACE_WITH_SOURCE_PREFIX",
            "to": "REPLACE_WITH_DESTINATION_PREFIX"
          }
        ]
      }
    }
  },
  "git_alias_sync": {
    "source_script": "REPLACE_WITH_ABSOLUTE_ALIAS_SCRIPT_PATH",
    "source_repo": "REPLACE_WITH_ABSOLUTE_SOURCE_REPOSITORY_PATH",
    "targets": [
      {
        "machine": "example-machine",
        "path": "REPLACE_WITH_REMOTE_SCRIPT_PATH"
      }
    ]
  },
  "wheel_sync": {
    "profiles": {
      "example-image": {
        "source_machine": "example-source-machine",
        "dist_dirs": [
          "REPLACE_WITH_FIRST_DIST_DIRECTORY",
          "REPLACE_WITH_SECOND_DIST_DIRECTORY"
        ],
        "destination_machines": [
          "example-source-machine",
          "example-destination-machine"
        ],
        "target_dir": "REPLACE_WITH_IMAGE_SPECIFIC_WHEEL_DIRECTORY",
        "expected_distributions": [
          "example_distribution_one",
          "example_distribution_two"
        ]
      }
    }
  },
  "qr_publish": {
    "repo_dir": "REPLACE_WITH_ABSOLUTE_REPO_DIRECTORY",
    "target_file": "REPLACE_WITH_REPOSITORY_RELATIVE_IMAGE_FILE",
    "branch": "REPLACE_WITH_BRANCH",
    "commit_message": "chore: update QR code ({date})",
    "reminder_title": "REPLACE_WITH_REMINDER_TITLE",
    "reminder_body": "REPLACE_WITH_REMINDER_BODY"
  }
}
